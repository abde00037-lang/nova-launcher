<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Nova.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:app="clr-namespace:Nova.App"
        Icon="Assets/nova.ico"
        Title="Nova Workbench"
        Height="820"
        Width="1320"
        MinHeight="680"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />

    <Style x:Key="ChevronButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlyoutRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="9,8" Margin="0,0,0,2">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>

  <!-- Outer Precision Frame -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="226" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT NAVIGATION RAIL -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Brand Identity Plate -->
          <Grid Grid.Row="0" Margin="18,18,16,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="{DynamicResource AccentBrush}">
              <Path Data="M4,18 L4,6 L8,6 L14,14 L14,6 L18,6 L18,18 L14,18 L8,10 L8,18 Z"
                    Fill="#FF11100E"
                    Stretch="Uniform"
                    Width="15"
                    Height="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NOVA" FontFamily="{StaticResource UiFont}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="MC WORKBENCH" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource DimBrush}" Margin="0,1,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource SecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding LauncherVersionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
            </Border>
          </Grid>

          <!-- Active Profile Switcher Box -->
          <Button Grid.Row="1"
                  x:Name="InstanceFlyoutButton"
                  automation:AutomationProperties.AutomationId="AllInstances"
                  automation:AutomationProperties.Name="Show all instances"
                  Margin="12,0,12,14"
                  Cursor="Hand"
                  ToolTip="Switch active Minecraft profile"
                  Click="ToggleInstanceFlyout_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Plate"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="11,9">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource SectionLabel}" FontSize="8.5" />
                      <TextBlock Text="{Binding HeaderTitle}" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding HeaderVersion}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Navigation Groups -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="10,0">
            <StackPanel>
              <TextBlock Text="LAUNCHPAD" Style="{StaticResource SectionLabel}" Margin="10,2,0,6" />

              <RadioButton x:Name="NavHome" automation:AutomationProperties.AutomationId="NavHome" automation:AutomationProperties.Name="Home" Style="{StaticResource NavButton}" IsChecked="True" Tag="Home" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Overview" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavInstances" automation:AutomationProperties.AutomationId="NavInstances" automation:AutomationProperties.Name="Instances" Style="{StaticResource NavButton}" Tag="Instances" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Profiles" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavVersions" automation:AutomationProperties.AutomationId="NavVersions" automation:AutomationProperties.Name="Versions" Style="{StaticResource NavButton}" Tag="Versions" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Versions &amp; Loaders" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavAccount" automation:AutomationProperties.AutomationId="NavAccount" automation:AutomationProperties.Name="Account" Style="{StaticResource NavButton}" Tag="Account" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Accounts" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <TextBlock Text="LIBRARY &amp; MODS" Style="{StaticResource SectionLabel}" Margin="10,16,0,6" />

              <RadioButton x:Name="NavMods" automation:AutomationProperties.AutomationId="NavMods" automation:AutomationProperties.Name="Mods" Style="{StaticResource NavButton}" Tag="Mods" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="13.5" Height="13.5" Margin="0,0,10.5,0" VerticalAlignment="Center">
                    <Path Data="M2.5,1.5 L5.6,1.5 A1.9,1.9 0 1 1 8.4,1.5L11.5,1.5 L11.5,4.6 A1.9,1.9 0 1 0 11.5,7.4L11.5,10.5 L8.4,10.5 A1.9,1.9 0 1 0 5.6,10.5L2.5,10.5 L2.5,7.4 A1.9,1.9 0 1 0 2.5,4.6"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  </Viewbox>
                  <TextBlock Text="Installed Mods" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavStore" automation:AutomationProperties.AutomationId="NavStore" automation:AutomationProperties.Name="Store" Style="{StaticResource NavButton}" Tag="Store" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Mod Catalog" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavWorlds" automation:AutomationProperties.AutomationId="NavWorlds" automation:AutomationProperties.Name="Worlds" Style="{StaticResource NavButton}" Tag="Worlds" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Saved Worlds" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionLabel}" Margin="10,16,0,6" />

              <RadioButton x:Name="NavBackups" automation:AutomationProperties.AutomationId="NavBackups" automation:AutomationProperties.Name="Backups" Style="{StaticResource NavButton}" Tag="Backups" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Snapshots" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavLogs" automation:AutomationProperties.AutomationId="NavLogs" automation:AutomationProperties.Name="Logs" Style="{StaticResource NavButton}" Tag="Logs" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Logs &amp; Crash" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="NavSettings" automation:AutomationProperties.AutomationId="NavSettings" automation:AutomationProperties.Name="Settings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                  <TextBlock Text="Configuration" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>

          <!-- Bottom Player & Root Strip -->
          <Border Grid.Row="3" Margin="12,10,12,12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="11,9">
            <StackPanel>
              <Grid>
                <TextBlock Text="PLAYER" Style="{StaticResource SectionLabel}" FontSize="9" />
                <TextBlock Text="{Binding HeaderAccount}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="120" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6" />
              <TextBlock Text="ROOT" Style="{StaticResource SectionLabel}" FontSize="8.5" />
              <TextBlock x:Name="RootPathText" Style="{StaticResource Muted}" FontSize="10" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- INSTANCE SWITCHER FLYOUT -->
      <Grid x:Name="FlyoutLayer" Grid.ColumnSpan="2" Panel.ZIndex="50" Visibility="Collapsed">
        <Border Background="#94090807" MouseLeftButtonDown="CloseFlyout_Click" />
        <Border Width="330"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="234,68,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.65" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <Grid Margin="6,4,4,8">
              <StackPanel>
                <TextBlock Text="SWITCH ACTIVE PROFILE" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding InstancePickerSummary}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ChevronButton}" automation:AutomationProperties.AutomationId="OpenInstancesPage" ToolTip="Manage all profiles" Click="OpenInstancesPage_Click">
                  <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" />
                </Button>
                <Button Style="{StaticResource ChevronButton}" Margin="4,0,0,0" automation:AutomationProperties.AutomationId="CloseFlyout" ToolTip="Close" Click="CloseFlyout_Click">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" />
                </Button>
              </StackPanel>
            </Grid>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding InstancePicker}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource FlyoutRow}"
                            Tag="{Binding}"
                            automation:AutomationProperties.AutomationId="PickInstance"
                            automation:AutomationProperties.Name="{Binding Name}"
                            Click="PickInstance_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                          <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- STORE VERSION PICKER MODAL -->
      <Grid Grid.ColumnSpan="2" Panel.ZIndex="55" Visibility="{Binding StoreTargetPickerVisible, Converter={StaticResource BoolVis}}">
        <Border Background="#A6090807" MouseLeftButtonDown="CloseStoreTarget_Click" />
        <Border Width="560" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="22,20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.65" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="MOD CATALOG TARGET VERSION" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Select which Minecraft version the catalog filters and downloads mods for." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0" />
              </StackPanel>
              <Button Style="{StaticResource ChevronButton}" HorizontalAlignment="Right" VerticalAlignment="Top" automation:AutomationProperties.AutomationId="CloseStoreTarget" Click="CloseStoreTarget_Click">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
              </Button>
            </Grid>
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
              <ItemsControl ItemsSource="{Binding StoreVersionChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,0,8,8"
                            Tag="{Binding}"
                            automation:AutomationProperties.AutomationId="StoreTargetChoice"
                            automation:AutomationProperties.Name="{Binding Label}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left"
                            Click="PickStoreTarget_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Chrome" Background="{DynamicResource SecondaryBrush}" CornerRadius="5" Padding="13,9" MinWidth="156" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- MODS FORGE TARGET PICKER MODAL -->
      <Grid Grid.ColumnSpan="2" Panel.ZIndex="56" Visibility="{Binding ModsTargetPickerVisible, Converter={StaticResource BoolVis}}">
        <Border Background="#A6090807" MouseLeftButtonDown="CloseModsTarget_Click" />
        <Border Width="540" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="22,20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.65" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="TARGET FORGE BUILD" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Installed Forge builds available for direct mod installation." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0" />
              </StackPanel>
              <Button Style="{StaticResource ChevronButton}" HorizontalAlignment="Right" VerticalAlignment="Top" automation:AutomationProperties.AutomationId="CloseModsTarget" Click="CloseModsTarget_Click">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
              </Button>
            </Grid>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
              <ItemsControl ItemsSource="{Binding ForgeTargets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,0,0,7"
                            Tag="{Binding}"
                            automation:AutomationProperties.AutomationId="ForgeTargetChoice"
                            automation:AutomationProperties.Name="{Binding Label}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Click="PickModsTarget_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Chrome" Background="{DynamicResource SecondaryBrush}" CornerRadius="5" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <Grid>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                  <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                              </StackPanel>
                              <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- LAUNCHER OTA UPDATE BANNER -->
      <Grid Grid.Column="1" Panel.ZIndex="46" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="26,46,26,0" automation:AutomationProperties.AutomationId="UpdateBanner" Visibility="{Binding LauncherUpdateBannerVisible, Converter={StaticResource BoolVis}}">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="14,11">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000" />
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
              <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding LauncherUpdateTitle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding LauncherUpdateDetail}" Style="{StaticResource Body}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="{Binding LauncherUpdateActionLabel}"
                      Style="{StaticResource PrimaryButton}"
                      FontSize="10.5"
                      Padding="13,7"
                      IsEnabled="{Binding CanApplyLauncherUpdate}"
                      Command="{Binding ApplyLauncherUpdateCommand}" />
              <Button Content="RELEASE NOTES" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="11,7" Margin="6,0,0,0" Command="{Binding OpenLauncherReleaseUrlCommand}" />
              <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Margin="6,0,0,0" Command="{Binding DismissLauncherUpdateCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- CRASH ALERT BANNER -->
      <Grid Grid.Column="1" Panel.ZIndex="45" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="26,46,26,0" automation:AutomationProperties.AutomationId="CrashBanner" Visibility="{Binding CrashBannerVisible, Converter={StaticResource BoolVis}}">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="5" Padding="14,11">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000" />
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="#2EE06D53" VerticalAlignment="Top">
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CrashTitle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="CrashTitle" />
                <TextBlock Text="{Binding CrashMeta}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding CrashDetail}" Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" automation:AutomationProperties.AutomationId="CrashDetail" />
              <TextBlock Text="{Binding CrashPath}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="{Binding DisableSuspectLabel}"
                      Style="{StaticResource PrimaryButton}"
                      Background="{DynamicResource DangerBrush}"
                      FontSize="10.5"
                      Padding="11,7"
                      Margin="0,0,6,0"
                      Visibility="{Binding HasCrashSuspect, Converter={StaticResource BoolVis}}"
                      Command="{Binding DisableCrashSuspectCommand}" />
              <Button Content="OPEN REPORT" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="11,7" automation:AutomationProperties.AutomationId="OpenCrashReport" Command="{Binding OpenCrashReportCommand}" />
              <Button Content="FOLDER" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="11,7" Margin="6,0,0,0" automation:AutomationProperties.AutomationId="OpenCrashFolder" Command="{Binding OpenCrashFolderCommand}" />
              <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Margin="6,0,0,0" automation:AutomationProperties.AutomationId="DismissCrash" Command="{Binding DismissCrashCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- CONFIRMATION DIALOG -->
      <Grid Grid.ColumnSpan="2" Panel.ZIndex="60" Visibility="{Binding ConfirmVisible, Converter={StaticResource BoolVis}}">
        <Border Background="#B0090807" />
        <Border Width="440" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="9" Opacity="0.65" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="4" Background="#2EE06D53">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding ConfirmTitle}" FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="350" />
            </StackPanel>
            <TextBlock Text="{Binding ConfirmBody}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,13,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
              <Button Content="CANCEL" Style="{StaticResource GhostButton}" FontSize="11" Padding="15,8" automation:AutomationProperties.AutomationId="ConfirmNo" Command="{Binding ConfirmNoCommand}" />
              <Button Content="{Binding ConfirmYesLabel}" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="15,8" Margin="8,0,0,0" Background="{DynamicResource DangerBrush}" automation:AutomationProperties.AutomationId="ConfirmYes" Command="{Binding ConfirmYesCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- RIGHT WORKSPACE AREA -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Top Instrument Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid x:Name="TitleBar">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
              <TextBlock Text="WORKBENCH" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
              <TextBlock Text=" / " FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="PageTitle" Text="OVERVIEW" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
              <Border Background="{DynamicResource SecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LauncherVersionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" />
              <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" />
              <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" Margin="2,0,0,0" Click="Close_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1" />
      </Grid>
    </Grid>
  </Border>
</Window>
