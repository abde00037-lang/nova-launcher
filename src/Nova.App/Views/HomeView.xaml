<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nova.App.Views">

  <Grid Margin="26,20,26,22">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <!-- LEFT DECK: Launch Stage + Telemetry Readouts -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Architectural Launch Stage -->
      <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True" MinHeight="330">
        <Grid>
          <!-- Subtle Architectural Grid Backdrop -->
          <Canvas IsHitTestVisible="False" Opacity="0.06">
            <Line X1="0" Y1="60" X2="900" Y2="60" Stroke="#FFF3EFE8" StrokeThickness="1" />
            <Line X1="0" Y1="140" X2="900" Y2="140" Stroke="#FFF3EFE8" StrokeThickness="1" />
            <Line X1="0" Y1="220" X2="900" Y2="220" Stroke="#FFF3EFE8" StrokeThickness="1" />
            <Line X1="160" Y1="0" X2="160" Y2="500" Stroke="#FFF3EFE8" StrokeThickness="1" />
            <Line X1="360" Y1="0" X2="360" Y2="500" Stroke="#FFF3EFE8" StrokeThickness="1" />
            <Line X1="560" Y1="0" X2="560" Y2="500" Stroke="#FFF3EFE8" StrokeThickness="1" />
          </Canvas>

          <!-- Optional User Hero Art -->
          <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.28" />

          <!-- Warm Vignette Overlay -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#401A1815" Offset="0" />
                <GradientStop Color="#CC1A1815" Offset="0.58" />
                <GradientStop Color="#FA151412" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- Top Accent Hairline -->
          <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" Opacity="0.85" />

          <Grid Margin="26,22,26,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Spec Badges -->
            <Grid Grid.Row="0">
              <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4">
                  <TextBlock Text="ACTIVE INSTANCE" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="9,4">
                  <TextBlock Text="{Binding HeaderMods}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                </Border>
                <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="9,4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderAccount}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <Button Content="OPEN FOLDER"
                      Style="{StaticResource GhostButton}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      FontSize="10.5"
                      Padding="11,6"
                      Command="{Binding OpenFolderCommand}" />
            </Grid>

            <!-- Center Title & Technical Metadata -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,20,0,0">
              <TextBlock Text="PROFILE IDENTIFIER" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="{Binding HeaderTitle}"
                         FontFamily="{StaticResource UiFont}"
                         FontSize="36"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextBrush}"
                         Margin="0,4,0,0"
                         TextTrimming="CharacterEllipsis" />

              <WrapPanel Margin="0,12,0,0">
                <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BUILD " FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderVersion}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DIR " FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Selected.GameDirectory}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>

            <!-- Bottom Control Deck -->
            <Border Grid.Row="2" Margin="0,20,0,0" Padding="0,18,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
              <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}"
                        FontSize="13.5"
                        MinWidth="168"
                        Height="44"
                        Margin="0,0,10,0"
                        Content="{Binding PlayLabel}"
                        Command="{Binding LaunchCommand}" />

                <Button Content="TERMINATE"
                        Style="{StaticResource GhostButton}"
                        Height="44"
                        Margin="0,0,8,0"
                        Padding="16,0"
                        Command="{Binding StopCommand}" />

                <Button Content="DOCTOR CHECK"
                        Style="{StaticResource GhostButton}"
                        Height="44"
                        Margin="0,0,8,0"
                        Padding="16,0"
                        Command="{Binding CheckCommand}" />

                <Button Content="REPAIR FILES"
                        Style="{StaticResource GhostButton}"
                        Height="44"
                        Padding="16,0"
                        Command="{Binding RepairCommand}" />
              </WrapPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Bottom 3 Hardware Readout Gauges -->
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="JAVA RUNTIME" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="JVM" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <TextBlock Text="{Binding JavaSummary}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="detected executable" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="HEAP ALLOCATION" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="-Xmx" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <TextBlock Text="{Binding MemorySummary}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
            <TextBlock Text="G1GC tuned memory ceiling" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,13">
          <StackPanel>
            <Grid>
              <TextBlock Text="LAST SESSION" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="CLOCK" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <TextBlock Text="{Binding PlayedSummary}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="recorded by workbench" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </Grid>

    <!-- RIGHT DECK: Live Status Meter + Diagnostic Terminal -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Live Execution / Download Progress Readout -->
      <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,15">
        <StackPanel>
          <Grid>
            <TextBlock Text="ENGINE TELEMETRY" Style="{StaticResource SectionLabel}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="LIVE" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource H2}" FontSize="18" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0" MaxHeight="52" />
          <ProgressBar Style="{StaticResource SlimProgress}"
                       Margin="0,12,0,0"
                       Maximum="1"
                       IsIndeterminate="{Binding StatusIndeterminate}"
                       Value="{Binding StatusProgress, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <!-- Diagnostic Console Stream -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="16,0,10,0">
            <TextBlock Text="DIAGNOSTIC STREAM" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <Button Content="CLEAR" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearConsole_Click" />
          </Grid>

          <Border Grid.Row="1" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
            <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" Padding="14,10">
              <ItemsControl ItemsSource="{Binding ConsoleLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource DimBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" />
                      <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Grid Grid.Row="2" Margin="16,0,12,0">
            <TextBlock Text="{Binding ConsoleLines.Count, StringFormat={}{0} events}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" />
            <Button Content="SNAPSHOT WORLDS" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding BackupCommand}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
