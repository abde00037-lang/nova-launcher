<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="ASSISTANT" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
        <TextBlock Text="AI Chat (Bring Your Own Key)" Style="{StaticResource H1}" />
        <TextBlock Text="Chat with your own AI endpoint. Keys stay DPAPI-encrypted on this PC; nothing is executed automatically."
                   Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <ComboBox x:Name="ProviderCombo" Width="190" Margin="0,2,8,0"
                  ItemsSource="{Binding AiChat.Providers}"
                  SelectedItem="{Binding AiChat.SelectedProvider}"
                  DisplayMemberPath="Name"
                  automation:AutomationProperties.AutomationId="AiProviderCombo" />
        <Button Content="MANAGE PROVIDERS" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="11,7"
                Command="{Binding AiChat.ManageCommand}"
                automation:AutomationProperties.AutomationId="AiManage" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
      <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    automation:AutomationProperties.AutomationId="AiChatScroll">
        <ItemsControl x:Name="ChatList" ItemsSource="{Binding AiChat.Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="2,4" Padding="10,8" CornerRadius="6"
                      Background="{DynamicResource SecondaryBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      HorizontalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" FontSize="8.5" Margin="0,0,0,3" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource SearchBox}" MinHeight="38"
               Text="{Binding AiChat.InputText, UpdateSourceTrigger=PropertyChanged}"
               KeyDown="InputBox_KeyDown"
               automation:AutomationProperties.AutomationId="AiInput" />
      <Button x:Name="SendButton" Grid.Column="1" Content="SEND" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="18,10"
              Command="{Binding AiChat.SendCommand}"
              automation:AutomationProperties.AutomationId="AiSend" />
    </Grid>
  </Grid>
</UserControl>
