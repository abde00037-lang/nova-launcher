<Window x:Class="Nova.App.Views.AiProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="AI Providers" Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="AI PROVIDERS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
      <TextBlock Text="Keys are encrypted with Windows DPAPI under ai\keys.dat and sent only to the provider you configure."
                 Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ProviderList" Grid.Column="0" Margin="0,0,10,0" SelectionChanged="ProviderList_SelectionChanged"
               DisplayMemberPath="Name" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
               BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource RowButton}"
               automation:AutomationProperties.AutomationId="AiProvList" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="QUICK SETUP" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <ComboBox x:Name="PresetCombo" Style="{StaticResource DarkComboBox}" Margin="0,2,0,8"
                  SelectionChanged="PresetCombo_SelectionChanged" automation:AutomationProperties.AutomationId="AiProvPreset">
          <ComboBoxItem Content="Choose a provider preset…" IsSelected="True" />
          <ComboBoxItem Content="AgentRouter" />
          <ComboBoxItem Content="OneAIKey" />
        </ComboBox>
        <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <TextBox x:Name="NameBox" Style="{StaticResource SearchBox}" Margin="0,2,0,8" automation:AutomationProperties.AutomationId="AiProvName" />
        <TextBlock Text="PROTOCOL" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <ComboBox x:Name="ProtocolCombo" Style="{StaticResource DarkComboBox}" Margin="0,2,0,8" automation:AutomationProperties.AutomationId="AiProvProtocol" />
        <TextBlock Text="BASE URL" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <TextBox x:Name="BaseUrlBox" Style="{StaticResource SearchBox}" Margin="0,2,0,8" automation:AutomationProperties.AutomationId="AiProvBase" />
        <TextBlock Text="MODEL IDs (copy exact IDs from the selected provider)" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <TextBox x:Name="ModelsBox" Style="{StaticResource SearchBox}" Margin="0,2,0,8" TextWrapping="Wrap" AcceptsReturn="False"
                 automation:AutomationProperties.AutomationId="AiProvModels" />
        <TextBlock Text="API KEY (leave empty to keep the stored key)" Style="{StaticResource SectionLabel}" FontSize="8.5" />
        <PasswordBox x:Name="KeyBox" Margin="0,2,0,10" automation:AutomationProperties.AutomationId="AiProvKey" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="SAVE PROVIDER" Style="{StaticResource PrimaryButton}" Padding="14,8" FontSize="10.5" Click="Save_Click"
                  automation:AutomationProperties.AutomationId="AiProvSave" />
          <Button x:Name="RemoveButton" Content="REMOVE" Style="{StaticResource GhostButton}" Padding="14,8" FontSize="10.5" Margin="8,0,0,0" Click="Remove_Click"
                  automation:AutomationProperties.AutomationId="AiProvRemove" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Button Grid.Row="2" Content="CLOSE" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,8" Click="Close_Click"
            automation:AutomationProperties.AutomationId="AiProvClose" />
  </Grid>
</Window>
