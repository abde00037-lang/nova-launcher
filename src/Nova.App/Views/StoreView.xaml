<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:views="clr-namespace:Nova.App.Views">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </UserControl.Resources>

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
        <TextBlock Text="REPOSITORY INDEX" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
        <TextBlock Text="Mod Catalog" Style="{StaticResource H1}" />
        <TextBlock Text="{Binding StoreTargetLabel}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Border Grid.Column="1" VerticalAlignment="Bottom" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="5" Padding="3">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="SegModrinth" Content="MODRINTH" Style="{StaticResource Segment}" Tag="Modrinth" IsChecked="True" Click="Source_Click" />
          <RadioButton x:Name="SegCurse" Content="CURSEFORGE" Style="{StaticResource Segment}" Tag="CurseForge" Click="Source_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="12,0" Height="40">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" Margin="0,0,10,0" />
          <TextBox x:Name="QueryBox" Grid.Column="1" Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                   automation:AutomationProperties.AutomationId="StoreQuery"
                   automation:AutomationProperties.Name="search mods"
                   Text="{Binding StoreQuery, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="Query_KeyDown" />
          <TextBlock Grid.Column="1" Text="Search Modrinth / CurseForge catalog…" Style="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding StoreQuery, Converter={StaticResource EmptyToVisible}}" />
        </Grid>
      </Border>

      <Button Grid.Column="1"
              automation:AutomationProperties.AutomationId="StoreTargetButton"
              automation:AutomationProperties.Name="mods for"
              Style="{StaticResource GhostButton}"
              Height="40"
              Margin="8,0,0,0"
              Padding="14,0"
              FontSize="10.5"
              ToolTip="Choose target Minecraft version"
              Content="{Binding StoreTargetChoiceLabel}"
              Click="Target_Click" />

      <Button Grid.Column="2"
              Style="{StaticResource GhostButton}"
              Height="40"
              Margin="8,0,0,0"
              Padding="14,0"
              FontSize="10.5"
              Content="{Binding StoreSortLabel}"
              Click="Sort_Click" />

      <Button Grid.Column="3"
              Content="SEARCH"
              Style="{StaticResource PrimaryButton}"
              Height="40"
              Margin="8,0,0,0"
              Padding="22,0"
              Command="{Binding SearchStoreCommand}" />
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <TextBlock Text="{Binding StoreStatus}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="DEPS AUTO-RESOLVED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10" ScrollChanged="Results_ScrollChanged">
          <ItemsControl ItemsSource="{Binding StoreItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardFlat}" Margin="0,0,0,7" Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="50" Height="50">
                      <Border CornerRadius="4" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="4" ClipToBounds="True" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                        <Image Stretch="UniformToFill" Source="{Binding IconPath}" />
                      </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="13,0,14,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="  ·  " Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="{Binding DownloadsLabel}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" />
                        <TextBlock Text=" downloads" Style="{StaticResource Muted}" FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11.5" Opacity="0.9" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                 Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding SourceLabel}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10" />
                    </Border>

                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="10.5"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Content="{Binding InstallLabel}"
                            IsEnabled="{Binding CanDownload}"
                            Command="{Binding DataContext.InstallStoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasMoreStore, Converter={StaticResource BoolVis}}">
          <Grid>
            <TextBlock Text="{Binding StoreStatus}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Content="LOAD MORE" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" FontSize="10.5" Padding="16,7" Click="LoadMore_Click" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
