<Window x:Class="Nova.App.Views.ModSnapshotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Mod snapshots" Width="660" Height="520" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Loaded="Window_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="MOD RECOVERY" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
      <TextBlock x:Name="HeadingText" Style="{StaticResource H1}" FontSize="19" />
      <TextBlock Text="Snapshots include mod files only—not worlds, configs, or the full instance. Files are SHA-256 checked before restoration; a recovery snapshot is saved first, and newer mods are disabled, not deleted. Deletion is permanent and requires confirmation."
                 Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="REFRESH" Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"
              automation:AutomationProperties.AutomationId="ModSnapshotsRefresh" Click="Refresh_Click" />
      <Button Grid.Column="2" Content="CREATE SNAPSHOT" Style="{StaticResource PrimaryButton}" Padding="13,7" Margin="6,0,0,0"
              automation:AutomationProperties.AutomationId="ModSnapshotsCreate" Click="Create_Click" />
    </Grid>

    <ListBox x:Name="SnapshotsList" Grid.Row="2" ItemsSource="{Binding}" SelectedValuePath="Id"
             BorderThickness="0" Background="Transparent" Padding="4"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             automation:AutomationProperties.AutomationId="ModSnapshotsList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource CardFlat}" Padding="12,10" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding CreatedLabel}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,3,0,0" />
                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Margin="0,3,0,0" Opacity="0.7" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileCountLabel}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="CLOSE" Style="{StaticResource GhostButton}" Padding="15,8" IsCancel="True" />
      <Button Content="DELETE SELECTED" Style="{StaticResource GhostButton}" Padding="15,8" Margin="8,0,0,0"
              automation:AutomationProperties.AutomationId="ModSnapshotsDelete" Click="Delete_Click" />
      <Button Content="RESTORE SELECTED" Style="{StaticResource PrimaryButton}" Padding="15,8" Margin="8,0,0,0"
              automation:AutomationProperties.AutomationId="ModSnapshotsRestore" Click="Restore_Click" />
    </StackPanel>
  </Grid>
</Window>
