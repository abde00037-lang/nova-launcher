<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.WorldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nova.App.Views">

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="SINGLEPLAYER SAVES" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
        <TextBlock Text="Saved Worlds" Style="{StaticResource H1}" />
        <TextBlock Text="Read-only inspection of the active profile's saves\ directory. Nova never alters level.dat or region files."
                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="OPEN SAVES FOLDER" Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,0,8,0" Click="OpenSaves_Click" />
        <Button Content="CREATE SNAPSHOT" Style="{StaticResource PrimaryButton}" FontSize="11.5" Padding="16,9" Command="{Binding BackupCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Worlds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardFlat}" Padding="14,11" Margin="0,0,0,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
