<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nova.App.Views">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20,26,28">
      <TextBlock Text="WORKBENCH PREFERENCES" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
      <TextBlock Text="Configuration" Style="{StaticResource H1}" />
      <TextBlock Text="Launcher self-updater channel, visual accent calibration, external API keys, and per-instance JVM parameters."
                 Style="{StaticResource Muted}" Margin="0,4,0,18" />

      <!-- Launcher Self-Updater Card -->
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="LAUNCHER SELF-UPDATER (OTA)" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2">
                <TextBlock Text="{Binding LauncherVersionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="AUTO-CHECK ON STARTUP" Style="{StaticResource SectionLabel}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoCheckLauncherUpdates, Mode=TwoWay}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Updates replace launcher files from GitHub Releases and may include the .NET runtime. Your instances, worlds, mods, accounts, and settings are kept."
                     Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0" Height="38">
              <TextBox Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                       Text="{Binding UpdateRepoSlug, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
            <Button Grid.Column="1" Content="CHECK FOR UPDATES" Style="{StaticResource GhostButton}" Height="38" Margin="8,0,0,0" Padding="15,0" FontSize="10.5"
                    IsEnabled="{Binding CanCheckLauncherUpdate}"
                    Command="{Binding CheckLauncherUpdateCommand}" />
            <Button Grid.Column="2" Content="{Binding LauncherUpdateActionLabel}" Style="{StaticResource PrimaryButton}" Height="38" Margin="8,0,0,0" Padding="16,0" FontSize="10.5"
                    Visibility="{Binding HasLauncherUpdate, Converter={StaticResource BoolVis}}"
                    IsEnabled="{Binding CanApplyLauncherUpdate}"
                    Command="{Binding ApplyLauncherUpdateCommand}" />
          </Grid>

          <TextBlock Text="{Binding LauncherUpdateStatus}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,9,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Appearance / Accent Swatches -->
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="HARDWARE ACCENT CALIBRATION" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Select the primary indicator tone across gauges, switches, and active controls." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,12" />
          <ListBox x:Name="AccentList" Background="Transparent" BorderThickness="0" SelectionChanged="Accent_Changed">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Ring"
                              CornerRadius="5"
                              Padding="12,8"
                              Background="{DynamicResource SecondaryBrush}"
                              BorderBrush="{DynamicResource BorderStrongBrush}"
                              BorderThickness="1">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Ring" Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                          <Setter TargetName="Ring" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- API Keys Grid -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- CurseForge API Key -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
          <StackPanel>
            <TextBlock Text="CURSEFORGE API TOKEN" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="Modrinth works with zero configuration. Add an Eternal API key from console.curseforge.com to unlock CurseForge search."
                       Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,12" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0" Height="38">
                <TextBox x:Name="CurseKeyBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
              </Border>
              <Button Grid.Column="1" Content="SAVE KEY" Style="{StaticResource PrimaryButton}" Height="38" Margin="8,0,0,0" Padding="16,0" FontSize="10.5" Click="SaveKey_Click" />
            </Grid>

            <TextBlock x:Name="KeyStatus" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- Microsoft Client ID -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
          <StackPanel>
            <TextBlock Text="MICROSOFT OAUTH2 CLIENT ID" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="Azure App Registration GUID with Live SDK / device-code support enabled for official Xbox &amp; Minecraft login."
                       Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,12" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0" Height="38">
                <TextBox x:Name="MsClientBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
              </Border>
              <Button Grid.Column="1" Content="SAVE ID" Style="{StaticResource PrimaryButton}" Height="38" Margin="8,0,0,0" Padding="16,0" FontSize="10.5" Click="SaveMsClient_Click" />
            </Grid>

            <TextBlock x:Name="MsClientStatus" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Per-Instance JVM & Launch Settings -->
      <Border Style="{StaticResource Card}" Padding="20,18">
        <StackPanel>
          <Grid>
            <TextBlock Text="SELECTED PROFILE RUNTIME PARAMETERS" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="MAX HEAP (MB)" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,0,12" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
              <Border Width="180" Height="36" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0">
                <TextBox x:Name="MemoryBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="e.g. 4096 (4 GB) or 8192 (8 GB)" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="FALLBACK HANDLE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,0,12" />
            <Border Grid.Row="1" Grid.Column="1" Width="260" Height="36" HorizontalAlignment="Left" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0" Margin="0,0,0,12">
              <TextBox x:Name="PlayerBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="JAVA OVERRIDE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,0,12" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
              <Border Height="36" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0">
                <TextBox x:Name="JavaPathBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Leave blank to let Nova auto-select the exact Java runtime (8 / 17 / 21) for this Minecraft version." Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="EXTRA JVM FLAGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,0,14" />
            <Border Grid.Row="3" Grid.Column="1" Height="36" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="11,0" Margin="0,0,0,14">
              <TextBox x:Name="JvmArgsBox" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="PRE-LAUNCH BACKUP" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ToggleButton x:Name="BackupBox" Style="{StaticResource Switch}" />
              <TextBlock Text="Snapshot modified saves\ worlds automatically before launching" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="APPLY TO PROFILE" Style="{StaticResource PrimaryButton}" Padding="18,10" Click="Save_Click" />
            <TextBlock x:Name="SavedText" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
