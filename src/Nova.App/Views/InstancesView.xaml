<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:views="clr-namespace:Nova.App.Views">

  <UserControl.Resources>
    <Style x:Key="InstanceRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowButton}">
      <Setter Property="automation:AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="automation:AutomationProperties.AutomationId" Value="{Binding Id}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
        <TextBlock Text="ISOLATED ENVIRONMENTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
        <TextBlock Text="Profiles &amp; Modpacks" Style="{StaticResource H1}" />
        <TextBlock Text="Manage independent Minecraft environments, run deep integrity checks, or import/export .mrpack and CurseForge archives."
                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>

      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="REFRESH" Style="{StaticResource GhostButton}" Margin="0,0,7,0" Command="{Binding RefreshCommand}" />
        <Button Content="CLONE" Style="{StaticResource GhostButton}" Margin="0,0,7,0" Click="Duplicate_Click" />
        <Button Content="DOCTOR" Style="{StaticResource GhostButton}" Margin="0,0,7,0" Command="{Binding CheckCommand}" />
        <Button Content="IMPORT PACK" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0" Click="Import_Click" />
        <Button Content="EXPORT" Style="{StaticResource GhostButton}" Click="Export_Click" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               Background="Transparent"
               BorderThickness="0"
               ItemContainerStyle="{StaticResource InstanceRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ItemsSource="{Binding Instances}"
               SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <TextBlock Text="SELECTED PROFILE SPECIFICATION" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" FontSize="19" Margin="0,6,0,14" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="136" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="IDENTIFIER" Style="{StaticResource SectionLabel}" Margin="0,2,0,10" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Id}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="VERSION" Style="{StaticResource SectionLabel}" Margin="0,2,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.VersionId}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GAME DIR" Style="{StaticResource SectionLabel}" Margin="0,2,0,10" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.GameDirectory}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="JAVA VM" Style="{StaticResource SectionLabel}" Margin="0,2,0,10" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.JavaLabel}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="MAX HEAP" Style="{StaticResource SectionLabel}" Margin="0,2,0,0" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.MemoryLabel}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Body}" FontSize="12" />
              </Grid>

              <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,16,0,14" />

              <Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DIRECTORY &amp; LIFECYCLE" Style="{StaticResource SectionLabel}" />
                  <TextBlock Text="External modpack directories outside instances\ are never deleted." Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Content="OPEN DIRECTORY" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="13,7" Command="{Binding OpenFolderCommand}" />
                  <Button Content="REMOVE PROFILE"
                          automation:AutomationProperties.AutomationId="DeleteInstance"
                          automation:AutomationProperties.Name="Delete instance"
                          Style="{StaticResource GhostButton}"
                          FontSize="10.5"
                          Padding="13,7"
                          Margin="8,0,0,0"
                          Foreground="{DynamicResource DangerBrush}"
                          Click="DeleteInstance_Click" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="INTEGRITY DIAGNOSTICS" Style="{StaticResource SectionLabel}" Margin="2,18,0,8" />

          <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,6">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" FontSize="10.5" />
                      </Border>
                      <TextBlock Text="{Binding Area}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
