<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Nova.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nova.App.Views">

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="SHA-256 VERIFIED ARCHIVES" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
        <TextBlock Text="World Snapshots" Style="{StaticResource H1}" />
        <TextBlock Text="Every snapshot stores a manifest and SHA-256 checksum. Restoring creates a clean copy without overwriting your current world."
                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="OPEN ARCHIVES" Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,0,8,0" Click="OpenFolder_Click" />
        <Button Content="SNAPSHOT CHANGED WORLDS" Style="{StaticResource PrimaryButton}" FontSize="11.5" Padding="16,9" Command="{Binding BackupCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardFlat}" Padding="14,11" Margin="0,0,0,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10" Opacity="0.7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="10,0,10,0"
                          Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}" FontSize="10" />
                  </Border>

                  <Button Grid.Column="2"
                          Content="RESTORE COPY"
                          Style="{StaticResource GhostButton}"
                          FontSize="10.5"
                          Padding="12,7"
                          VerticalAlignment="Center"
                          Tag="{Binding}"
                          Click="Restore_Click" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
