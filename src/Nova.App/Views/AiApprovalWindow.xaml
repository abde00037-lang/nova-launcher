<Window x:Class="Nova.App.Views.AiApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="AI agent approval" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <StackPanel Margin="20">
    <TextBlock Text="AI AGENT WRITE ACTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
    <TextBlock x:Name="ToolText" Style="{StaticResource H1}" FontSize="16" Margin="0,0,0,8" />
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
      <TextBlock x:Name="ArgsText" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
    </Border>
    <TextBlock x:Name="NoteText" Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,14" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DenyButton" Content="DENY" Style="{StaticResource GhostButton}" Padding="16,9" Click="Deny_Click"
              automation:AutomationProperties.AutomationId="AiApproveDeny" />
      <Button x:Name="AllowButton" Content="ALLOW" Style="{StaticResource PrimaryButton}" Padding="16,9" Margin="8,0,0,0" Click="Allow_Click"
              automation:AutomationProperties.AutomationId="AiApproveAllow" />
    </StackPanel>
  </StackPanel>
</Window>
